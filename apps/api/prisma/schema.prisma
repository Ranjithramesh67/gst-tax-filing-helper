// GSTFlow Prisma schema — PostgreSQL
// This schema is a frozen contract. Do not change field names without updating
// @gstflow/types and @gstflow/validation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleScope {
  SYSTEM
  FIRM
}

enum FirmStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum LinkStatus {
  PENDING
  ACTIVE
  REJECTED
  REVOKED
}

enum DevicePlatform {
  ANDROID
  IOS
}

enum SmsCategory {
  GST_INVOICE
  GST_RETURN
  EWAY_BILL
  TAX_PAYMENT
  GST_NOTICE
  UNCLASSIFIED
  OTHER
}

enum SmsStatus {
  RECEIVED
  REVIEWED
  FILED
  IGNORED
  FAILED
}

enum DocumentType {
  BILL
  TAX_FILED_COPY
  INVOICE_COPY
  GST_CERTIFICATE
  OTHER
}

enum ReturnType {
  GSTR1
  GSTR3B
  GSTR9
  OTHER
}

enum FilingStatus {
  PENDING
  IN_REVIEW
  FILED
  REJECTED
}

enum ReleaseChannel {
  STABLE
  BETA
}

enum OtpPurpose {
  CLIENT_ONBOARDING
  DEVICE_PAIRING
  LOGIN
}

enum OtpSource {
  SMS
  EMAIL
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

enum BillingInvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  VOID
}

enum BillingInvoiceType {
  PER_FILING
  CUMULATIVE
  SUBSCRIPTION
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum PaymentRequestProvider {
  MANUAL
  CASHFREE
}

model Firm {
  id               String     @id @default(cuid())
  name             String
  slug             String     @unique
  gstin            String?
  email            String?
  phone            String?
  logoUrl          String?
  brandColor       String?
  supportEmail     String?
  supportPhone     String?
  address          String?
  defaultFilingFee Float?
  status           FirmStatus @default(ACTIVE)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  users     User[]
  clients   Client[]
  auditLogs AuditLog[]
  payments  Payment[]

  roles           Role[]
  billingInvoices BillingInvoice[]
  subscriptions   Subscription[]
  paymentRequests PaymentRequest[]

  @@index([status])
}

model Role {
  id          String    @id @default(cuid())
  key         String
  name        String
  description String?
  scope       RoleScope @default(FIRM)
  firmId      String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  firm        Firm?            @relation(fields: [firmId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       User[]

  @@unique([firmId, key])
  @@index([scope])
}

model RolePermission {
  id         String @id @default(cuid())
  roleId     String
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@index([permission])
}

model User {
  id           String    @id @default(cuid())
  firmId       String?
  email        String    @unique
  name         String
  phone        String?
  passwordHash String
  roleId       String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  firm              Firm?          @relation(fields: [firmId], references: [id], onDelete: SetNull)
  role              Role?          @relation(fields: [roleId], references: [id], onDelete: SetNull)
  refreshTokens     RefreshToken[]
  uploadedDocuments Document[]     @relation("DocumentUploader")
  auditLogs         AuditLog[]

  @@index([firmId])
  @@index([roleId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String?
  clientId  String?
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
}

model Client {
  id             String       @id @default(cuid())
  firmId         String
  name           String
  gstin          String?
  pan            String?
  email          String?
  phone          String
  address        String?
  stateCode      String?
  status         ClientStatus @default(ACTIVE)
  consentGranted Boolean      @default(false)
  linkStatus       LinkStatus @default(ACTIVE)
  linkRequestedAt  DateTime   @default(now())
  linkConfirmedAt  DateTime?
  linkRejectedAt   DateTime?
  linkRevokedAt    DateTime?
  linkNote         String?
  lastSmsAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  firm          Firm            @relation(fields: [firmId], references: [id], onDelete: Cascade)
  devices       Device[]
  consents      ConsentRecord[]
  smsMessages   SmsMessage[]
  documents     Document[]
  invoices      Invoice[]
  returns       GstReturn[]
  filings       Filing[]
  refreshTokens RefreshToken[]
  payments      Payment[]
  statusEvents  FilingStatusEvent[]

  billingInvoices BillingInvoice[]
  subscriptions   Subscription[]
  paymentRequests PaymentRequest[]

  @@index([firmId, status])
  @@index([gstin])
  @@index([phone])
  @@index([linkStatus])
}

model Device {
  id         String         @id @default(cuid())
  clientId   String
  platform   DevicePlatform
  androidId  String
  model      String?
  osVersion  String?
  appVersion String?
  pushToken  String?
  revoked    Boolean        @default(false)
  lastSeenAt DateTime?
  createdAt  DateTime       @default(now())

  client      Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  consents    ConsentRecord[]
  smsMessages SmsMessage[]

  @@unique([clientId, androidId])
  @@index([clientId])
}

model ConsentRecord {
  id          String    @id @default(cuid())
  clientId    String
  deviceId    String?
  version     String
  acceptedAt  DateTime  @default(now())
  ip          String?
  otpVerified Boolean   @default(false)
  revokedAt   DateTime?

  client Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([clientId])
}

model OtpVerification {
  id         String     @id @default(cuid())
  phone      String
  codeHash   String
  purpose    OtpPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([phone, purpose])
}

model SmsMessage {
  id            String      @id @default(cuid())
  clientId      String
  deviceId      String?
  sender        String
  bodyEncrypted String
  receivedAt    DateTime
  category      SmsCategory @default(UNCLASSIFIED)
  status        SmsStatus   @default(RECEIVED)
  hash          String
  createdAt     DateTime    @default(now())

  client    Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  device    Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  parsed    ParsedGstData?
  documents Document[]

  @@unique([clientId, hash])
  @@index([clientId, receivedAt])
  @@index([status])
  @@index([category])
}

model ParsedGstData {
  id           String    @id @default(cuid())
  smsMessageId String    @unique
  gstin        String?
  invoiceNo    String?
  amount       Float?
  taxableValue Float?
  taxAmount    Float?
  hsn          String?
  dueDate      DateTime?
  returnType   ReturnType?
  period       String?
  arn          String?
  lateFee      Float?
  filed        Boolean?
  confidence   Float     @default(0)
  rawJson      Json?

  smsMessage SmsMessage @relation(fields: [smsMessageId], references: [id], onDelete: Cascade)
}

// Encrypted backup of SMS messages that were removed from the live inbox by the
// retention policy. Not exposed to firms or clients; super-admin only. Rows are
// hard-deleted once `purgeAt` passes.
model SmsMessageArchive {
  id            String      @id @default(cuid())
  originalId    String
  clientId      String
  deviceId      String?
  sender        String
  bodyEncrypted String
  receivedAt    DateTime
  category      SmsCategory @default(UNCLASSIFIED)
  status        SmsStatus   @default(RECEIVED)
  hash          String
  parsed        Json?
  archivedAt    DateTime    @default(now())
  purgeAt       DateTime

  @@index([purgeAt])
  @@index([clientId, receivedAt])
  @@index([originalId])
}

// Generic key/value store for platform-wide settings (e.g. SMS retention).
model SystemSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@index([updatedAt])
}

model Document {
  id           String       @id @default(cuid())
  clientId     String
  smsMessageId String?
  type         DocumentType @default(OTHER)
  fileName     String
  mimeType     String
  size         Int
  storageKey   String
  uploadedById String?
  createdAt    DateTime     @default(now())

  client     Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  smsMessage SmsMessage? @relation(fields: [smsMessageId], references: [id], onDelete: SetNull)
  uploadedBy User?       @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([smsMessageId])
}

model Invoice {
  id                String    @id @default(cuid())
  clientId          String
  smsMessageId      String?
  invoiceNo         String?
  invoiceDate       DateTime?
  counterpartyGstin String?
  taxableValue      Float?
  taxAmount         Float?
  totalAmount       Float?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model GstReturn {
  id          String       @id @default(cuid())
  clientId    String
  type        ReturnType
  period      String
  status      FilingStatus @default(PENDING)
  dueDate     DateTime?
  filedAt     DateTime?
  filedById   String?
  referenceNo String?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  filings Filing[]
  statusEvents FilingStatusEvent[]

  @@unique([clientId, type, period])
  @@index([clientId, status])
}

model Filing {
  id          String       @id @default(cuid())
  clientId    String
  returnId    String?
  type        ReturnType
  period      String
  status      FilingStatus @default(PENDING)
  feeAmount   Float?
  filedById   String?
  filedAt     DateTime?
  referenceNo String?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  gstReturn GstReturn? @relation(fields: [returnId], references: [id], onDelete: SetNull)
  payments  Payment[]

  billingItems    BillingInvoiceItem[]
  paymentRequests PaymentRequest[]
  statusEvents    FilingStatusEvent[]

  @@index([clientId, status])
  @@index([returnId])
}

enum FilingEventSource {
  MANUAL
  SMS
  SYSTEM
}

model FilingStatusEvent {
  id             String            @id @default(cuid())
  filingId       String?
  returnId       String?
  clientId       String
  status         FilingStatus
  previousStatus FilingStatus?
  source         FilingEventSource @default(MANUAL)
  actorId        String?
  actorName      String?
  smsMessageId   String?
  note           String?
  createdAt      DateTime          @default(now())

  filing    Filing?    @relation(fields: [filingId], references: [id], onDelete: Cascade)
  gstReturn GstReturn? @relation(fields: [returnId], references: [id], onDelete: Cascade)
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([filingId, createdAt])
  @@index([returnId, createdAt])
  @@index([clientId, createdAt])
}

model AppRelease {
  id          String         @id @default(cuid())
  platform    DevicePlatform
  version     String
  versionCode Int
  channel     ReleaseChannel @default(STABLE)
  url         String
  checksum    String?
  changelog   String?
  mandatory   Boolean        @default(false)
  publishedAt DateTime       @default(now())

  @@unique([platform, versionCode, channel])
  @@index([platform, channel])
}

enum SmsProviderKind {
  PING4SMS
}

model SmsProviderConfig {
  id              String          @id @default(cuid())
  name            String
  provider        SmsProviderKind @default(PING4SMS)
  isActive        Boolean         @default(false)
  url             String
  method          String          @default("GET")
  sender          String
  route           String?
  templateId      String?
  header          String?
  credentials     String
  messageTemplate String
  appName         String
  variables       Json?
  timeoutMs       Int             @default(8000)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  updatedById     String?

  @@index([isActive])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  firmId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  firm  Firm? @relation(fields: [firmId], references: [id], onDelete: SetNull)

  @@index([firmId, createdAt])
  @@index([entity, entityId])
  @@index([action])
}

model Payment {
  id        String         @id @default(cuid())
  firmId    String
  clientId  String
  filingId  String?
  invoiceId String?
  amount    Float
  status    PaymentStatus  @default(PENDING)
  method    PaymentMethod?
  paidAt    DateTime?
  reference String?
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  firm    Firm            @relation(fields: [firmId], references: [id], onDelete: Cascade)
  client  Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  filing  Filing?         @relation(fields: [filingId], references: [id], onDelete: Cascade)
  invoice BillingInvoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  links   PaymentLink[]

  @@index([firmId, status])
  @@index([filingId])
  @@index([invoiceId])
  @@index([clientId])
}

model PaymentLink {
  id        String   @id @default(cuid())
  paymentId String
  label     String
  url       String
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model BillingInvoice {
  id        String               @id @default(cuid())
  firmId    String
  clientId  String
  number    String
  type      BillingInvoiceType   @default(PER_FILING)
  status    BillingInvoiceStatus @default(DRAFT)
  issueDate DateTime             @default(now())
  dueDate   DateTime?
  subtotal  Float                @default(0)
  total     Float                @default(0)
  notes     String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  firm     Firm                 @relation(fields: [firmId], references: [id], onDelete: Cascade)
  client   Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items    BillingInvoiceItem[]
  payments Payment[]
  requests PaymentRequest[]

  @@unique([firmId, number])
  @@index([firmId, status])
  @@index([clientId])
}

model BillingInvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  filingId    String?
  description String
  amount      Float
  createdAt   DateTime @default(now())

  invoice BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  filing  Filing?        @relation(fields: [filingId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([filingId])
}

model Subscription {
  id          String       @id @default(cuid())
  firmId      String
  clientId    String
  amount      Float
  cycle       BillingCycle @default(MONTHLY)
  startDate   DateTime
  nextDueDate DateTime
  active      Boolean      @default(true)
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([firmId, active])
  @@index([clientId])
}

model PaymentRequest {
  id          String                 @id @default(cuid())
  firmId      String
  clientId    String
  invoiceId   String?
  filingId    String?
  amount      Float
  description String?
  status      PaymentStatus          @default(PENDING)
  provider    PaymentRequestProvider @default(MANUAL)
  providerRef String?
  url         String?
  expiresAt   DateTime?
  paidAt      DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  firm    Firm            @relation(fields: [firmId], references: [id], onDelete: Cascade)
  client  Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoice BillingInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  filing  Filing?         @relation(fields: [filingId], references: [id], onDelete: SetNull)

  @@index([firmId, status])
  @@index([clientId])
  @@index([providerRef])
}

model Notification {
  id        String    @id @default(cuid())
  firmId    String
  userId    String?
  clientId  String?
  type      String
  title     String
  body      String
  entity    String?
  entityId  String?
  meta      Json?
  dedupeKey String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([firmId, dedupeKey])
  @@index([firmId, readAt])
  @@index([clientId, readAt])
}

model OtpEvent {
  id          String    @id @default(cuid())
  firmId      String
  clientId    String
  deviceId    String?
  code        String
  source      OtpSource
  fromAddress String?
  subject     String?
  snippet     String?
  receivedAt  DateTime
  sourceRef   String?
  groupId     String?
  createdAt   DateTime  @default(now())

  @@unique([clientId, source, sourceRef])
  @@index([firmId, receivedAt])
  @@index([clientId, code, receivedAt])
  @@index([groupId])
}
