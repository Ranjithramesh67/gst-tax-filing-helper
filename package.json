{
  "name": "gstflow",
  "version": "0.1.0",
  "private": true,
  "description": "GSTFlow - GST filing automation platform (admin + firm webapp + client mobile + API)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "db:generate": "npm run db:generate --workspace @gstflow/api",
    "db:migrate": "npm run db:migrate --workspace @gstflow/api",
    "db:seed": "npm run db:seed --workspace @gstflow/api",
    "api:dev": "npm run dev --workspace @gstflow/api",
    "web:dev": "npm run dev --workspace @gstflow/web",
    "admin:dev": "npm run dev --workspace @gstflow/admin",
    "mobile:start": "npm run start --workspace @gstflow/mobile"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "10.9.4"
    }
  }
}
